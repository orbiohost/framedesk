# Copy to .env and fill in. The server refuses to start if anything here is invalid.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Number of reverse proxies in front of the API (1 behind Nginx/OpenLiteSpeed), so req.ip is the real client IP.
TRUST_PROXY=0

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/framedesk?retryWrites=true&w=majority

# Where the React app is served from. Used for CORS and for links in emails.
CLIENT_URL=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Must be true in production (HTTPS). Set false only for local http development.
COOKIE_SECURE=false
# Leave empty unless the client and API live on different subdomains of one parent domain.
COOKIE_DOMAIN=

# Email (verification, password reset) is sent through Gmail with a Google app password:
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an app password at https://myaccount.google.com/apppasswords
#   3. Put the Gmail address in SMTP_USER and the 16-character app password in SMTP_PASS
#      (spaces are fine). Gmail sends as SMTP_USER, so use that address in MAIL_FROM too.
# "console" logs emails instead of sending them (development only).
MAIL_TRANSPORT=smtp
MAIL_FROM="FrameDesk <your-address@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Uploaded files are kept in an Amazon S3 bucket (or an S3-compatible store such
# as Cloudflare R2 or MinIO). Required. The bucket stays private: browsers get
# short-lived signed links that stream straight from S3. The bucket needs a CORS
# rule for CLIENT_URL (see deploy/s3-cors.json and README, "File storage").
S3_BUCKET=
S3_REGION=
# Leave both empty on AWS to use an IAM role / instance profile instead of keys.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for S3-compatible stores (R2, MinIO, Wasabi); leave empty for AWS.
S3_ENDPOINT=
# true for MinIO and some other S3-compatible stores.
S3_FORCE_PATH_STYLE=false
# Optional folder inside the bucket, ending in "/", e.g. framedesk/
S3_KEY_PREFIX=

# Unfinished (resumable) uploads wait here until they are pushed to the bucket.
# Relative paths resolve against the server folder.
UPLOAD_STAGING_DIR=./data/upload-staging
# Largest single file, in GB.
MAX_UPLOAD_GB=20
# Largest backup zip that can be uploaded to restore, in GB.
MAX_RESTORE_GB=100
# Optional: signs short-lived download links. Derived from JWT_ACCESS_SECRET if empty.
FILE_URL_SECRET=

# Optional: speech-to-text (video transcripts, dictated notes) via the "asr"
# container (Qwen3-ASR). docker-compose.yml sets both. Leave empty to hide the feature.
# Generate the key like JWT_ACCESS_SECRET; the asr container needs the same one.
# "Translate to English" uses Gemini (GEMINI_API_KEY below).
# Optional Redis for the request cache and shared rate limits (docker-compose
# sets redis://redis:6379). Locally: docker run -d -p 127.0.0.1:6379:6379 redis:7.4-alpine
# and REDIS_URL=redis://localhost:6379. Leave empty to run without it.
REDIS_URL=

ASR_URL=
ASR_API_KEY=

# Optional: the AI assistant (analyses uploaded files and answers questions
# about them) runs on Google Gemini. Key from https://aistudio.google.com/apikey
# Leave empty to keep the assistant off. Turn it on and set credits in Admin > AI.
GEMINI_API_KEY=
# Default model; Admin > AI can switch it without a deploy.
GEMINI_MODEL=gemini-3.5-flash

# Optional: "Create image" in the AI chat runs on Cloudflare Workers AI (FLUX),
# free up to ~95 images a day. Account ID is in the Cloudflare dashboard sidebar;
# token from My Profile > API Tokens > Create Token > "Workers AI" template.
# Chat and file analysis stay on Gemini.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# "Continue with Google" sign-in. Leave both empty to hide the button.
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID
# (Web application). Authorised redirect URI: <CLIENT_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Social Media hub: link real accounts. Each pair is optional; platforms
# without keys can still be added by hand (stats and posts typed in).
#
# Instagram (professional accounts: Business or Creator):
#   developers.facebook.com > Create app > add "Instagram" product >
#   "API setup with Instagram login". Use the *Instagram* app ID/secret shown
#   there. Redirect URI: <CLIENT_URL>/api/social/oauth/instagram/callback
#   Permissions: instagram_business_basic, instagram_business_manage_insights
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Facebook Pages: same Meta app > add "Facebook Login for Business".
#   Redirect URI: <CLIENT_URL>/api/social/oauth/facebook/callback
#   Permissions: pages_show_list, pages_read_engagement, read_insights
META_APP_ID=
META_APP_SECRET=
# YouTube: uses GOOGLE_CLIENT_ID/SECRET above unless these are set. Enable
#   "YouTube Data API v3" in that Google Cloud project, add the scope
#   youtube.readonly to the consent screen and the redirect URI
#   <CLIENT_URL>/api/social/oauth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# YouTube API key (optional): add any channel from just its link, public stats
#   only, no login. Google Cloud > Credentials > Create API key, restrict it to
#   "YouTube Data API v3".
YOUTUBE_API_KEY=
# All of these can instead be pasted in the app: Admin > Social apps.
# TikTok: developers.tiktok.com > app with Login Kit + scopes user.info.basic,
#   user.info.stats, video.list. Redirect URI: <CLIENT_URL>/api/social/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional (32+ chars): encrypts stored social tokens. Defaults to a key derived
# from JWT_ACCESS_SECRET (rotating that then means re-linking accounts).
SOCIAL_TOKEN_SECRET=

# Cloudflare Turnstile (free CAPTCHA) on signup, login and forgot-password.
# Cloudflare dashboard > Turnstile > Add widget (your domain, mode "Managed").
# Leave both empty to turn it off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Signup email rules. standard = block temporary/disposable inboxes and
# domains with no mail server. strict = also block free mailboxes other than
# Gmail (only Gmail + work email allowed).
EMAIL_SIGNUP_MODE=standard
# Extra domains to block at signup, comma separated.
EMAIL_BLOCKED_DOMAINS=

# Optional starting values for invoicing. Once you save Admin > Invoicing,
# the values there are used instead and these are ignored.
# Separate address lines with "|".
INVOICE_BUSINESS_NAME=
INVOICE_BUSINESS_ADDRESS=
INVOICE_BUSINESS_EMAIL=
INVOICE_BUSINESS_GSTIN=
# GST is added on top of plan prices (and shown on invoices) only when
# INVOICE_BUSINESS_GSTIN is set. 18% is the rate for software services.
GST_RATE=18
# Optional SAC code printed on tax invoices.
GST_SAC_CODE=

# Optional: online payments with Razorpay (Dashboard > Account & Settings > API keys).
# Use rzp_test_ keys while testing. Leave both empty to keep the manual
# "we'll send you a payment link" flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://<your-domain>/api/billing/razorpay/webhook,
# events payment.authorized, payment.captured, order.paid, payment.failed,
# refund.processed and payment.dispute.created, and this secret.
# Required whenever the keys above are set: without it, payments whose browser
# closed before confirming, and refunds, are never picked up.
RAZORPAY_WEBHOOK_SECRET=

# Web push: reminders for events and deadlines on phones and desktops.
# Generate a pair once with: npx web-push generate-vapid-keys
# Leave empty to send reminders by email only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https:). Defaults to CLIENT_URL.
VAPID_SUBJECT=
