{
  "name": "framedesk-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch-path=src --watch-path=.env src/server.js",
    "start": "node src/server.js",
    "seed:users": "node scripts/seedUsers.js",
    "migrate:storage-pools": "node scripts/migrateStoragePools.js",
