    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "argon2": "^0.41.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "file-type": "^22.3.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "nodemailer": "^10.3.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "yauzl": "^3.4.0",
