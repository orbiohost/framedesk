# Copy to .env and fill in. The server refuses to start if anything here is invalid.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Number of reverse proxies in front of the API (1 behind Nginx/OpenLiteSpeed), so req.ip is the real client IP.
TRUST_PROXY=0

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/framedesk?retryWrites=true&w=majority

# Where the React app is served from. Used for CORS and for links in emails.
CLIENT_URL=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Must be true in production (HTTPS). Set false only for local http development.
COOKIE_SECURE=false
# Leave empty unless the client and API live on different subdomains of one parent domain.
COOKIE_DOMAIN=

# Email (verification, password reset) is sent through Gmail with a Google app password:
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an app password at https://myaccount.google.com/apppasswords
#   3. Put the Gmail address in SMTP_USER and the 16-character app password in SMTP_PASS
#      (spaces are fine). Gmail sends as SMTP_USER, so use that address in MAIL_FROM too.
# "console" logs emails instead of sending them (development only).
MAIL_TRANSPORT=smtp
MAIL_FROM="FrameDesk <your-address@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Uploaded files are kept in an Amazon S3 bucket (or an S3-compatible store such
# as Cloudflare R2 or MinIO). Required. The bucket stays private: browsers get
# short-lived signed links that stream straight from S3. The bucket needs a CORS
# rule for CLIENT_URL (see deploy/s3-cors.json and README, "File storage").
S3_BUCKET=
S3_REGION=
# Leave both empty on AWS to use an IAM role / instance profile instead of keys.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for S3-compatible stores (R2, MinIO, Wasabi); leave empty for AWS.
S3_ENDPOINT=
# true for MinIO and some other S3-compatible stores.
S3_FORCE_PATH_STYLE=false
# Optional folder inside the bucket, ending in "/", e.g. framedesk/
S3_KEY_PREFIX=

# Unfinished (resumable) uploads wait here until they are pushed to the bucket.
# Relative paths resolve against the server folder.
UPLOAD_STAGING_DIR=./data/upload-staging
# Largest single file, in GB.
MAX_UPLOAD_GB=20
# Largest backup zip that can be uploaded to restore, in GB.
MAX_RESTORE_GB=100
# Optional: signs short-lived download links. Derived from JWT_ACCESS_SECRET if empty.
FILE_URL_SECRET=

# Optional: speech-to-text (video transcripts, dictated notes) via the "whisper"
# container. docker-compose.yml sets both. Leave empty to hide the feature.
# Generate the key like JWT_ACCESS_SECRET; the whisper container needs the same one.
# Optional Redis for the request cache and shared rate limits (docker-compose
# sets redis://redis:6379). Locally: docker run -d -p 127.0.0.1:6379:6379 redis:7.4-alpine
# and REDIS_URL=redis://localhost:6379. Leave empty to run without it.
REDIS_URL=

WHISPER_URL=
WHISPER_API_KEY=
